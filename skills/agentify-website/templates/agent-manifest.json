{
  "brand": "<Site name> Assistant",
  "networks": [
    {
      "name": "<network_name>",
      "front_man": "<front_agent_name>",
      "hocon": "./<network_name>.network.json",
      "description": "TODO: one sentence a visitor reads at the top of the chat.",
      "tags": [
        "agentified-website"
      ],
      "sample_queries": [
        "TODO: copy metadata.sample_queries from the HOCON"
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Local agents and page-local actions only."
  },
  "agent_mcp": {
    "protocol": "<protocol_name>-agent-mcp/v1",
    "network": "<network_name>",
    "front_man": "<front_agent_name>",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#2563eb"
  },
  "linking": {
    "protocol": "<protocol_name>-link/v1",
    "exports": [
      {
        "network": "<network_name>",
        "front_man": "<front_agent_name>",
        "aliases": [
          "<network_name>",
          "<front_agent_name>"
        ],
        "url": "<network_name>"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "agentTools": [
      "<read_action>",
      "<write_action>",
      "<irreversible_action>"
    ]
  }
}
